{
  "name": "theory-2-jan-2026",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "predev": "pnpm unocss:build",
    "dev": "concurrently \"pnpm unocss:watch\" \"next dev\"",
    "prebuild": "pnpm unocss:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "unocss:build": "unocss \"src/**/*.{js,jsx,ts,tsx}\" --config unocss.config.js -o src/styles/unocss.css",
    "unocss:watch": "unocss \"src/**/*.{js,jsx,ts,tsx}\" --config unocss.config.js -w -o src/styles/unocss.css",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@unocss/cli": "^66.6.2",
    "@unocss/postcss": "^66.6.2",
    "@unocss/preset-uno": "^66.6.2",
    "@unocss/reset": "^66.6.2",
    "@unocss/webpack": "^66.6.2",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "unocss": "^66.6.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
